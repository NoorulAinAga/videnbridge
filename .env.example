# Contact form email delivery (SMTP)
# Use your company SMTP or a transactional email provider's SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# The inbox where website enquiries should arrive
CONTACT_TO=enquiries@videnbridge.com

# The sender address must be permitted by your SMTP provider
CONTACT_FROM=website@videnbridge.com

# Optional future CMS switch. Keep local while developing.
CONTENT_SOURCE=local
STRAPI_URL=https://your-strapi-domain.com
STRAPI_API_TOKEN=
